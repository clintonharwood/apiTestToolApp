<%- include('partials/_head', { title: 'Clintox — Salesforce Test Tool' }) %>

<div class="page-header">
  <h1>Salesforce Test Tool</h1>
  <p class="page-desc">A collection of tools for testing Salesforce OAuth flows, APIs, and integrations.</p>
</div>

<% if (!orgConfig) { %>
<div class="alert alert-warning mb-4" role="alert">
  No org configured. <a href="/setup">Set up your Connected App</a> to use the test tools.
</div>
<% } else { %>
<div class="alert alert-success mb-4" role="alert">
  Connected to <strong><%= orgConfig.instanceUrl %></strong>. <a href="/setup">Change config</a>
</div>
<% } %>

<ul class="tool-list">
  <li><a href="/setup">Org Setup</a></li>
  <li><a href="/auth">OAuth Test</a></li>
  <% if (webToCaseEnabled) { %><li><a href="/webtocase">Web To Case Test</a></li><% } %>
  <li><a href="/createaccount">Salesforce REST API — Create Account</a></li>
  <li><a href="/downloadReport">Download Salesforce Report</a></li>
  <li><a href="/createPlatformEvent">Create Platform Event</a></li>
  <li><a href="/chaos">Data Integrity Chaos Mode</a></li>
  <li><a href="/soql">SOQL Query Runner</a></li>
  <li><a href="/metadata">Metadata</a></li>
  <li><a href="/admin">Admin</a></li>
</ul>

<%- include('partials/_foot') %>
